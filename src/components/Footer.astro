---
---
<footer>
  <div class="ft">
    <div class="fbrand">
      <a href="/" class="logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="1" width="30" height="30" rx="6.5" stroke="#c9a84c" stroke-width="1.5"/>
          <line x1="8" y1="12" x2="22" y2="12" stroke="#c9a84c" stroke-width="1.8" stroke-linecap="round"/>
          <polyline points="20,10 22,12 20,14" stroke="#c9a84c" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <line x1="24" y1="20" x2="10" y2="20" stroke="#c9a84c" stroke-width="1.8" stroke-linecap="round"/>
          <polyline points="12,18 10,20 12,22" stroke="#c9a84c" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
        <span class="lt">Crypto<em>2</em>Cash.io</span>
      </a>
      <p>The B2B matching platform connecting businesses to compliant, high-volume crypto-to-fiat providers. We don't hold funds. We connect you to licensed operators.</p>
    </div>
    <div class="fnav">
      <div>
        <div class="fct">Platform</div>
        <ul class="fcl">
          <li><a href="/#quotes">Get Quotes</a></li>
          <li><a href="/#solutions">Provider Network</a></li>
          <li><a href="/api-access/">API Access</a></li>
        </ul>
      </div>
      <div>
        <div class="fct">Solutions</div>
        <ul class="fcl">
          <li><a href="/#solutions">E-Commerce</a></li>
          <li><a href="/#solutions">DAOs &amp; Web3</a></li>
          <li><a href="/#solutions">Freelancer Platforms</a></li>
        </ul>
      </div>
      <div>
        <div class="fct">Company</div>
        <ul class="fcl">
          <li><a href="/company/">About</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/api-access/">API</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="fb">
    <div class="fcp">© 2026 Crypto2Cash.io<br>A comparison and lead generation platform.</div>
    <div class="flg">Crypto2Cash.io is a comparison and referral platform. We are not a licensed money services business, money transmitter, or financial institution. All conversions are executed by licensed third-party providers.</div>
  </div>
</footer>

<style>
footer{padding:60px 48px 40px;border-top:1px solid var(--border);position:relative;z-index:1}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;margin-bottom:16px}
.lt{font-weight:800;font-size:1.05rem;color:var(--cream)}
.lt em{font-style:normal;color:var(--gold)}
.ft{display:grid;grid-template-columns:1fr 2fr;gap:80px;padding-bottom:48px;border-bottom:1px solid var(--border);margin-bottom:32px}
.fbrand p{font-size:.85rem;color:var(--slate2);line-height:1.7;max-width:260px}
.fnav{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
.fct{font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--gold);letter-spacing:.14em;text-transform:uppercase;margin-bottom:16px}
.fcl{list-style:none;display:flex;flex-direction:column;gap:10px}
.fcl a{color:var(--slate2);text-decoration:none;font-size:.875rem;transition:color .2s}
.fcl a:hover{color:#e8e4dc}
.fb{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}
.fcp{font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--slate2);line-height:1.6}
.flg{font-family:'JetBrains Mono',monospace;font-size:.65rem;color:rgba(74,81,102,.7);text-align:right;max-width:480px;line-height:1.6}
@media(max-width:900px){footer{padding:40px 20px}.ft{grid-template-columns:1fr;gap:40px}.fnav{grid-template-columns:1fr 1fr}.flg{text-align:left}}
</style>
