---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getPublicClient } from '../../lib/supabase';

const { slug } = Astro.params;
const env = (Astro.locals as any).runtime?.env ?? {};
let post: any = null;
try {
  const supabase = getPublicClient(env);
  const { data } = await supabase
    .from('blog_posts')
    .select('*')
    .eq('slug', slug)
    .eq('published', true)
    .single();
  post = data;
} catch {}

if (!post) return Astro.redirect('/blog/');
---
<BaseLayout title={`${post.title} — Crypto2Cash.io`} description={post.meta_description} canonical={`https://crypto2cash.io/blog/${post.slug}/`}>
  <Nav/>
  <main class="post-main">
    <div class="post-header">
      <div class="bcat">{post.category}</div>
      <h1>{post.title}</h1>
      <div class="pmeta">{post.author} · {new Date(post.published_at).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</div>
    </div>
    <article class="post-body" set:html={post.content}/>
    <div class="post-cta">
      <h3>Ready to get business quotes?</h3>
      <a href="/#quotes" class="bgo">Request Quotes Now →</a>
    </div>
  </main>
  <Footer/>
</BaseLayout>

<style>
.post-main{padding:140px 48px 80px;max-width:760px;margin:0 auto;position:relative;z-index:1}
.post-header{margin-bottom:48px;padding-bottom:48px;border-bottom:1px solid var(--border)}
.bcat{font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--gold);letter-spacing:.12em;text-transform:uppercase;margin-bottom:16px}
h1{font-family:'Instrument Serif',serif;font-size:clamp(2rem,4vw,3rem);font-weight:400;color:#f0ece3;line-height:1.1;margin-bottom:16px}
.pmeta{font-family:'JetBrains Mono',monospace;font-size:.72rem;color:var(--slate2)}
.post-body{font-size:1rem;color:#c8c4bc;line-height:1.85}
.post-body h2{font-family:'Instrument Serif',serif;font-size:1.75rem;color:#f0ece3;margin:48px 0 16px;font-weight:400}
.post-body h3{font-size:1.1rem;color:#e8e4dc;margin:32px 0 12px;font-weight:600}
.post-body p{margin-bottom:20px}
.post-body ul,.post-body ol{padding-left:24px;margin-bottom:20px;display:flex;flex-direction:column;gap:8px}
.post-body a{color:var(--gold);text-decoration:underline;text-underline-offset:3px}
.post-cta{margin-top:64px;padding:40px;background:var(--ink2);border:1px solid rgba(201,168,76,.2);border-radius:12px;text-align:center}
.post-cta h3{font-family:'Instrument Serif',serif;font-size:1.5rem;color:#f0ece3;margin-bottom:20px;font-weight:400}
.bgo{background:var(--gold);color:var(--ink);font-weight:600;padding:12px 28px;border-radius:6px;text-decoration:none;display:inline-block;transition:background .2s}
.bgo:hover{background:var(--gold2)}
@media(max-width:900px){.post-main{padding:100px 20px 60px}}
</style>
