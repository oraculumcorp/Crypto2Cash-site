---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="API Access — Crypto2Cash.io" description="Programmatic access to crypto-to-fiat liquidity provider data, quote routing, and corridor intelligence. Built for AI agents and fintech platforms.">
  <Nav/>
  <main class="page-main">
    <div class="slbl"><span class="slbt">Developer</span></div>
    <h1 class="sh">API Access</h1>
    <p class="lead">Programmatic crypto-to-fiat liquidity routing for AI agents, fintech platforms, and automated treasury systems.</p>

    <div class="feature-grid">
      <div class="feat"><div class="fi">⚡</div><div class="ft2">Real-Time Quote Routing</div><p>Submit conversion requirements via API and receive ranked provider quotes in milliseconds.</p></div>
      <div class="feat"><div class="fi">🔒</div><div class="ft2">Compliance-First</div><p>Every provider in our network is licensed. Full KYB documentation available on request.</p></div>
      <div class="feat"><div class="fi">🤖</div><div class="ft2">AI Agent Ready</div><p>Built for autonomous agents managing treasury, payroll, and stablecoin off-ramps programmatically.</p></div>
      <div class="feat"><div class="fi">🌐</div><div class="ft2">40+ Corridors</div><p>Global payout rails across North America, Europe, Africa, Asia, and Latin America.</p></div>
    </div>

    <div class="waitlist-card">
      <div class="wt">Join the API Waitlist</div>
      <p class="wd">Early access for qualified platforms. We're onboarding AI infrastructure companies, fintech operators, and high-volume businesses first.</p>
      <div class="wform" id="waitlistForm">
        <input type="email" class="ci" id="wEmail" placeholder="Business email"/>
        <input type="text" class="ci" id="wCompany" placeholder="Company name"/>
        <input type="text" class="ci" id="wUseCase" placeholder="Describe your use case"/>
        <button class="csub" id="wSubmit">Request API Access →</button>
      </div>
      <div class="wsuccess" id="wSuccess">✓ You're on the list. We'll be in touch shortly.</div>
    </div>
  </main>
  <Footer/>
</BaseLayout>

<style>
.page-main{padding:140px 48px 80px;max-width:860px;margin:0 auto;position:relative;z-index:1}
.slbl{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.slbl::before{content:'';width:24px;height:1px;background:var(--gold)}
.slbt{font-family:'JetBrains Mono',monospace;font-size:.72rem;color:var(--gold);letter-spacing:.14em;text-transform:uppercase}
.sh{font-family:'Instrument Serif',serif;font-size:clamp(2rem,3.5vw,3rem);font-weight:400;color:#f0ece3;line-height:1.1;margin-bottom:16px}
.lead{font-size:1.05rem;color:var(--slate2);line-height:1.75;max-width:520px;margin-bottom:64px}
.feature-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:64px}
.feat{padding:36px 32px;background:var(--ink)}
.fi{font-size:1.75rem;margin-bottom:16px;display:block}
.ft2{font-size:1rem;font-weight:600;color:#e8e4dc;margin-bottom:10px}
.feat p{font-size:.875rem;color:var(--slate2);line-height:1.7}
.waitlist-card{background:var(--ink2);border:1px solid rgba(201,168,76,.2);border-radius:12px;padding:48px}
.wt{font-family:'Instrument Serif',serif;font-size:1.75rem;color:#f0ece3;margin-bottom:12px;font-weight:400}
.wd{font-size:.9rem;color:var(--slate2);line-height:1.7;margin-bottom:32px;max-width:460px}
.wform{display:flex;flex-direction:column;gap:10px;max-width:420px}
.ci{background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:6px;padding:12px 16px;font-family:'Instrument Sans',sans-serif;font-size:.875rem;color:#e8e4dc;outline:none;transition:border-color .2s}
.ci:focus{border-color:rgba(201,168,76,.4)}
.ci::placeholder{color:var(--slate2)}
.csub{background:var(--gold);color:var(--ink);font-family:'Instrument Sans',sans-serif;font-weight:600;font-size:.9rem;border:none;border-radius:6px;padding:13px 24px;cursor:pointer;transition:all .2s}
.csub:hover{background:var(--gold2)}
.csub:disabled{opacity:.6;cursor:not-allowed}
.wsuccess{display:none;font-family:'JetBrains Mono',monospace;font-size:.82rem;color:var(--gold);margin-top:16px;line-height:1.6}
@media(max-width:900px){.page-main{padding:100px 20px 60px}.feature-grid{grid-template-columns:1fr}.waitlist-card{padding:32px}}
</style>

<script>
document.getElementById('wSubmit')?.addEventListener('click', async () => {
  const email = (document.getElementById('wEmail') as HTMLInputElement)?.value.trim();
  const company = (document.getElementById('wCompany') as HTMLInputElement)?.value.trim();
  const use_case = (document.getElementById('wUseCase') as HTMLInputElement)?.value.trim();
  if (!email) { (document.getElementById('wEmail') as HTMLElement).style.borderColor = 'rgba(201,168,76,.6)'; return; }
  const btn = document.getElementById('wSubmit') as HTMLButtonElement;
  btn.textContent = 'Submitting...'; btn.disabled = true;
  try {
    await fetch('/api/waitlist', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, company, use_case }),
    });
    const form = document.getElementById('waitlistForm') as HTMLElement;
    const success = document.getElementById('wSuccess') as HTMLElement;
    if (form) form.style.display = 'none';
    if (success) success.style.display = 'block';
  } catch { btn.textContent = 'Request API Access →'; btn.disabled = false; }
});
</script>
